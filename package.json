{
  "name": "marginly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:functions": "deno lint --config supabase/functions/deno.json supabase/functions",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "deno check --config supabase/functions/deno.json supabase/functions",
    "test": "vitest run",
    "test:functions": "deno test --config supabase/functions/deno.json supabase/functions",
    "db:types": "bash scripts/db-types.sh generate",
    "db:types:check": "bash scripts/db-types.sh check",
    "no-service-role": "bash scripts/no-service-role.sh",
    "verify": "npm run no-service-role && npm run lint && npm run lint:functions && npm run typecheck && npm run typecheck:functions && npm run db:types:check && npm run test && npm run test:functions",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
